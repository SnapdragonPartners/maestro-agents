{
  "agent_type": "addepar-intake",
  "namespace": "intake",
  "store": {"kind": "file", "dir": "../../.local/addepar/state"},
  "trigger": {"kind": "one_shot"},
  "model": {
    "provider": "anthropic",
    "name": "claude-opus-5-5",
    "credential": "anthropic",
    "timeout": "5m"
  },
  "credentials": {"env": {"anthropic": "ANTHROPIC_API_KEY"}},
  "budgets": {"turns": 16, "active_time": "10m", "tokens": 600000, "tokens_estimated": true},
  "telemetry": {"sink": "store"},
  "log": {"level": "info"}
}
